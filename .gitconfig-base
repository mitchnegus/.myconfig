# This is Git's per-user configuration file.
[user]
	name = mitch
[color]
	ui = auto
[alias]
	# Git configuration help (show repo root, list all aliases, etc.)
	root = rev-parse --show-toplevel
	alias = "!git config --get-regexp '^alias\\.' | sed -e 's/^alias\\.//' -e 's/\\ /\\ =\\ /' | sort"
	# Manage staging
	unstage = "!: restore; f() { git restore --staged \"${1:-.}\"; }; f"
	oust = rm -r --cached
	# Amend commits
	amend = commit --amend --no-edit
	reword = commit --amend --only
	# Display commit information and history
	brief = show -s --oneline
	last = log -1 HEAD --stat
	logg = log --graph --pretty=short --all --abbrev-commit --oneline --decorate
	# Manage branch references
	search-remote-branches = "!: branch; f() { git branch -r --format='%(refname:short)' --list \"*${1:-..}*\"; }; f"
	prune-tracking = "!: branch; f() { git branch -dr $(git search-remote-branches \"$1\"); }; f"
	sync-local = "!: pull; f() { git checkout \"$2\" && git merge -ff-only \"$1/$2\"; }; f"
	sync-remote = "!: pull; f() { git fetch \"$1\" && git sync-local \"$1\" \"$2\"; }; f"
	# Rewriting history
	pushf = push --force-with-lease --force-if-includes
	stash-apply-file = "!f() { git -C \"$GIT_PREFIX\" restore --source=\"stash@{${2:-0}}\" -- \"${1?path required}\"; }; f"
	rebase-multiple = "!: rebase; git-rebase-multiple"
	amendrebase = "!echo 'Prefer `git history fixup` (https://git-scm.com/docs/git-history)'"
	# In case of emergency...
	flee = "!f() { git checkout -b \"$(date +%Y%m%d-%H%M%S)-wip\" && git commit --no-verify -am \"WIP: I'll be back...\" && git push origin HEAD; }; f"
[init]
	defaultBranch = main
[log]
	date = local
[diff]
	tool = vimdiff
[difftool]
	prompt = false
[difftool "vimdiff"]
	cmd = vimdiff \"$LOCAL\" \"$REMOTE\"
[merge]
	tool = vimdiff
	conflictstyle = diff3
[mergetool "vimdiff"]
	cmd = vimdiff \"$LOCAL\" \"$MERGED\" \"$REMOTE\"
[rebase]
	updateRefs = true
[interactive]
	diffFilter = diff-highlight
[pager]
	diff = diff-highlight | less
	# Add a newline to the Git log pager to account for the two-line prompt
	log = "(printf '\n'; diff-highlight) | less"
	show = diff-highlight | less
[lfs]
	cachecredentials = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
